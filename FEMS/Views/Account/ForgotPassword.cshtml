@model FEMS.ViewModels.Account.ForgotPasswordViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-viewport-wrapper">
    <div class="auth-card">
        <!-- BÊN TRÁI: FORM QUÊN MẬT KHẨU -->
        <section class="auth-form-column">
            <!-- Thương hiệu FEMS tối giản -->
            <div class="auth-brand-badge">
                <span class="brand-badge-name">FEMS</span>
            </div>

            <div class="auth-form-header">
                <h1 class="auth-title">Quên mật khẩu?</h1>
                <p class="auth-subtitle">Nhập email đã đăng ký để nhận mã xác minh đặt lại mật khẩu.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="auth-alert auth-alert-error">
                    <span class="alert-icon">&#9888;</span>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post"
                  class="auth-form-body">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                <!-- Email Input -->
                <div class="auth-form-group">
                    <label asp-for="Email" class="auth-label">Địa chỉ Email</label>
                    <input asp-for="Email"
                           class="auth-input"
                           placeholder="name@example.com"
                           autocomplete="email"
                           autofocus />
                    <span asp-validation-for="Email" class="auth-field-error"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="auth-submit-btn">
                    Gửi mã OTP
                </button>

                <!-- Back Link -->
                <a asp-controller="Account" asp-action="Login" class="auth-secondary-link">
                    &#8592; Quay lại đăng nhập
                </a>
            </form>
        </section>

        <!-- BÊN PHẢI: KHU VỰC GIỚI THIỆU (VÀNG - NÂU) -->
        <section class="auth-intro-column">
            <div class="intro-decoration-circle circle-1"></div>
            <div class="intro-decoration-circle circle-2"></div>
            <div class="intro-decoration-ring"></div>
            <div class="intro-decoration-grid"></div>

            <div class="intro-content">
                <div class="intro-brand-tag">
                    <span class="intro-brand-icon">&#128274;</span>
                    <span class="intro-brand-title">BẢO MẬT FEMS</span>
                </div>

                <h2 class="intro-heading">Khôi phục quyền truy cập</h2>

                <p class="intro-description">
                    Mã xác minh an toàn (OTP) 8 chữ số sẽ được gửi trực tiếp tới hòm thư của bạn để bảo vệ tài sản và dữ liệu tài chính gia đình.
                </p>

                <div class="intro-action">
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="intro-pill-btn">
                        Đăng nhập
                    </a>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

