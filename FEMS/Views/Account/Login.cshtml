@model FEMS.ViewModels.Account.LoginViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-viewport-wrapper">
    <div class="auth-card auth-card-login">
        <!-- BÊN TRÁI: FORM ĐĂNG NHẬP -->
        <section class="auth-form-column">
            <!-- Thương hiệu FEMS tối giản góc trên bên trái -->
            <div class="auth-brand-badge">
                <span class="brand-badge-name">FEMS</span>
            </div>

            <div class="auth-form-header">
                <h1 class="auth-title">Đăng nhập</h1>
                <p class="auth-subtitle">Chào mừng bạn quay trở lại FEMS.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="auth-alert auth-alert-success">
                    <span class="alert-icon">&#10003;</span>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="auth-alert auth-alert-error">
                    <span class="alert-icon">&#9888;</span>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  class="auth-form-body">

                <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                <!-- Email field (Không có placeholder) -->
                <div class="auth-form-group">
                    <label asp-for="Email" class="auth-label">Email</label>
                    <input asp-for="Email"
                           class="auth-input"
                           autocomplete="username" />
                    <span asp-validation-for="Email" class="auth-field-error"></span>
                </div>

                <!-- Password field (Không có placeholder) -->
                <div class="auth-form-group">
                    <label asp-for="Password" class="auth-label">Mật khẩu</label>
                    <input asp-for="Password"
                           class="auth-input"
                           autocomplete="current-password" />
                    <span asp-validation-for="Password" class="auth-field-error"></span>
                </div>

                <!-- Liên kết Quên mật khẩu -->
                <div class="auth-forgot-row">
                    <a asp-controller="Account" asp-action="ForgotPassword" class="auth-forgot-link">Quên mật khẩu?</a>
                </div>

                <!-- Nút Đăng nhập chính -->
                <button type="submit" class="auth-submit-btn">
                    Đăng nhập
                </button>
            </form>
        </section>

        <!-- BÊN PHẢI: KHU VỰC GIỚI THIỆU (VÀNG - NÂU) -->
        <section class="auth-intro-column">
            <!-- Họa tiết trang trí hình học sinh động -->
            <div class="intro-decoration-circle circle-1"></div>
            <div class="intro-decoration-circle circle-2"></div>
            <div class="intro-decoration-ring"></div>
            <div class="intro-decoration-grid"></div>

            <div class="intro-content">
                <div class="intro-brand-tag">
                    <span class="intro-brand-icon">&#128176;</span>
                    <span class="intro-brand-title">FEMS</span>
                </div>

                <h2 class="intro-heading">Chào mừng bạn!</h2>

                <p class="intro-description">
                    Quản lý tài chính gia đình dễ dàng hơn. Theo dõi thu nhập, chi tiêu và kiểm soát dòng tiền trong một nền tảng duy nhất.
                </p>

                <!-- Pill Button điều hướng sang Register -->
                <div class="intro-action">
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="intro-pill-btn">
                        Đăng ký
                    </a>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
