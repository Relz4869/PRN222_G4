@model FEMS.ViewModels.Account.RegisterViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Đăng ký";
}

<div class="auth-viewport-wrapper">
    <div class="auth-card auth-card-register">
        <!-- BÊN TRÁI: KHU VỰC GIỚI THIỆU (THEO PHONG CÁCH HÌNH 2) -->
        <section class="auth-intro-column">
            <!-- Họa tiết trang trí hình học sinh động -->
            <div class="intro-decoration-circle circle-1"></div>
            <div class="intro-decoration-circle circle-2"></div>
            <div class="intro-decoration-ring"></div>
            <div class="intro-decoration-grid"></div>

            <div class="intro-content">
                <div class="intro-brand-tag">
                    <span class="intro-brand-icon">&#127969;</span>
                    <span class="intro-brand-title">FEMS</span>
                </div>

                <h2 class="intro-heading">Chào mừng trở lại!</h2>

                <p class="intro-description">
                    Bạn đã có tài khoản? Hãy đăng nhập để tiếp tục quản lý tài chính gia đình.
                </p>

                <!-- Pill Button điều hướng sang Login -->
                <div class="intro-action">
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="intro-pill-btn">
                        Đăng nhập
                    </a>
                </div>
            </div>
        </section>

        <!-- BÊN PHẢI: FORM ĐĂNG KÝ (XANH LÁ CÂY NHẠT) -->
        <section class="auth-form-column">
            <!-- Thương hiệu chữ FEMS tối giản góc trên -->
            <div class="auth-brand-badge">
                <span class="brand-badge-name">FEMS</span>
            </div>

            <div class="auth-form-header">
                <h1 class="auth-title">Tạo tài khoản</h1>
                <p class="auth-subtitle">Bắt đầu quản lý tài chính gia đình cùng FEMS.</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post"
                  class="auth-form-body">

                <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                <!-- Họ và tên (Không có placeholder) -->
                <div class="auth-form-group">
                    <label asp-for="FullName" class="auth-label">Họ và tên</label>
                    <input asp-for="FullName"
                           class="auth-input"
                           autocomplete="name" />
                    <span asp-validation-for="FullName" class="auth-field-error"></span>
                </div>

                <!-- Email (Không có placeholder) -->
                <div class="auth-form-group">
                    <label asp-for="Email" class="auth-label">Email</label>
                    <input asp-for="Email"
                           class="auth-input"
                           autocomplete="email" />
                    <span asp-validation-for="Email" class="auth-field-error"></span>
                </div>

                <!-- Số điện thoại (Không có placeholder) -->
                <div class="auth-form-group">
                    <label asp-for="Phone" class="auth-label">Số điện thoại</label>
                    <input asp-for="Phone"
                           class="auth-input"
                           type="tel"
                           autocomplete="tel" />
                    <span asp-validation-for="Phone" class="auth-field-error"></span>
                </div>

                <!-- Mật khẩu (Không có placeholder) -->
                <div class="auth-form-group">
                    <label asp-for="Password" class="auth-label">Mật khẩu</label>
                    <input asp-for="Password"
                           class="auth-input"
                           autocomplete="new-password" />
                    <span asp-validation-for="Password" class="auth-field-error"></span>
                </div>

                <!-- Xác nhận mật khẩu (Không có placeholder) -->
                <div class="auth-form-group">
                    <label asp-for="ConfirmPassword" class="auth-label">Xác nhận mật khẩu</label>
                    <input asp-for="ConfirmPassword"
                           class="auth-input"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                </div>

                <!-- Nút Đăng ký chính -->
                <button type="submit" class="auth-submit-btn">
                    Đăng ký
                </button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
