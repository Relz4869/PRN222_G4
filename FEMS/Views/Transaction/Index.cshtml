@model FEMS.ViewModels.Transaction.TransactionManagementViewModel

@{
    ViewData["Title"] = "Giao dịch";

    // Cấu hình phân trang: 10 lượt giao dịch / 1 trang
    int totalTransactionCount = Model.Transactions.Count;
    int pageSize = 10;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = (int)Math.Ceiling((double)totalTransactionCount / pageSize);
    if (totalPages < 1) totalPages = 1;
    if (currentPage < 1) currentPage = 1;
    if (currentPage > totalPages) currentPage = totalPages;

    var pagedTransactions = Model.Transactions
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
}

<div class="transaction-page">

    <!-- Thông báo Thành công / Lỗi -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="tx-alert tx-alert-success">
            <span>&#10004; <strong>Thành công:</strong> @TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="tx-alert tx-alert-error">
            <span>&#9888; <strong>Thông báo:</strong> @TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="row g-4 align-items-start">

        <!-- =================================================
             CỘT TRÁI: GHI NHẬN GIAO DỊCH MỚI (CREATE TRANSACTION)
        ================================================== -->
        <div class="col-lg-4 col-md-5">
            <div class="tx-left-panel">
                <h6 class="tx-panel-heading mb-3">
                    <span class="me-1">&#128221;</span> Ghi nhận Giao dịch
                </h6>

                @if (!Model.Wallets.Any())
                {
                    <div class="tx-empty-wallet-note mb-3">
                        Bạn chưa có ví cá nhân nào. Vui lòng
                        <a asp-controller="Wallet" asp-action="Index" class="fw-bold text-teal-link">tạo Ví cá nhân</a>
                        trước khi ghi nhận giao dịch.
                    </div>
                }

                <form asp-controller="Transaction" asp-action="Create" method="post" id="createTransactionForm">
                    <input type="hidden" name="FilterWalletId" value="@Model.FilterWalletId" />
                    <input type="hidden" name="FilterMonth" value="@Model.FilterMonth" />
                    <input type="hidden" name="TransactionType" id="txTypeInput" value="@Model.TransactionType" />

                    <!-- 2 Nút chuyển đổi chế độ: Chi tiêu (Expense) / Thu nhập (Income) -->
                    <div class="tx-type-switcher mb-3">
                        <button type="button"
                                id="btnExpenseMode"
                                class="btn-tx-mode @(Model.TransactionType != "Income" ? "mode-expense-active" : "")"
                                onclick="switchTransactionMode('Expense')">
                            &#8854; Chi tiêu
                        </button>

                        <button type="button"
                                id="btnIncomeMode"
                                class="btn-tx-mode @(Model.TransactionType == "Income" ? "mode-income-active" : "")"
                                onclick="switchTransactionMode('Income')">
                            &#8853; Thu nhập
                        </button>
                    </div>

                    <!-- Chọn Ví cá nhân -->
                    <div class="mb-3">
                        <div class="tx-field-box">
                            <span class="tx-field-prefix">Chọn Ví:</span>
                            <select name="WalletId" class="tx-inline-select" required>
                                @foreach (var w in Model.Wallets)
                                {
                                    <option value="@w.WalletId" selected="@(Model.WalletId == w.WalletId)">
                                        @w.WalletName (@w.Amount.ToString("N0") VNĐ)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Danh mục chi tiêu (Bắt buộc với Expense, tự động ẩn/khóa khi chọn Income) -->
                    <div class="mb-3" id="categoryFieldWrapper">
                        <div class="tx-field-box tx-field-category">
                            <span class="tx-field-prefix text-teal-label">
                                Danh mục chi tiêu:
                            </span>
                            <select name="CategoryId" id="categoryIdSelect" class="tx-inline-select text-teal-label fw-bold">
                                @if (Model.ActiveCategories.Any())
                                {
                                    @foreach (var cat in Model.ActiveCategories)
                                    {
                                        <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">
                                            @cat.CategoryName
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value="">-- Chưa có danh mục hoạt động --</option>
                                }
                            </select>
                        </div>
                        @if (!Model.ActiveCategories.Any())
                        {
                            <div class="small mt-1 text-warning-note">
                                &#9888; Bạn chưa có danh mục chi tiêu đang hoạt động.
                                <a asp-controller="Category" asp-action="Index" class="fw-bold text-teal-link">Tạo danh mục ngay</a>
                            </div>
                        }
                    </div>

                    <!-- Hàng Số tiền & Ngày giao dịch -->
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <div class="tx-field-box">
                                <span class="tx-field-prefix fw-bold text-dark">Số tiền:</span>
                                <input type="number"
                                       name="Amount"
                                       min="1"
                                       step="any"
                                       value="@(Model.Amount > 0 ? ((long)Model.Amount).ToString() : "")"
                                       class="tx-inline-input fw-bold"
                                       placeholder="500.000 VNĐ"
                                       required />
                            </div>
                        </div>

                        <div class="col-5">
                            <div class="tx-field-box">
                                <span class="tx-field-prefix">Ngày:</span>
                                <input type="date"
                                       name="TransactionDate"
                                       value="@Model.TransactionDate.ToString("yyyy-MM-dd")"
                                       class="tx-inline-date"
                                       required />
                            </div>
                        </div>
                    </div>

                    <!-- Mô tả giao dịch -->
                    <div class="mb-3">
                        <div class="tx-field-box">
                            <span class="tx-field-prefix text-secondary">Mô tả:</span>
                            <input type="text"
                                   name="Description"
                                   value="@Model.Description"
                                   class="tx-inline-input"
                                   placeholder="Mua đồ ăn tối cho gia đình" />
                        </div>
                    </div>

                    <!-- Nút Submit -->
                    <button type="submit"
                            class="btn-save-transaction w-100"
                            disabled="@(!Model.Wallets.Any())">
                        Lưu Giao dịch 
                    </button>
                </form>
            </div>
        </div>

        <!-- =================================================
             CỘT PHẢI: LỊCH SỬ GIAO DỊCH CÁ NHÂN (VIEW OWN TRANSACTIONS)
        ================================================== -->
        <div class="col-lg-8 col-md-7">
            <div class="tx-right-panel">

                <!-- Tiêu đề & Bộ lọc (Lọc Ví cá nhân | Lọc Tháng/Năm) -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h5 class="tx-history-heading mb-0">
                        Lịch sử giao dịch 
                    </h5>

                    <form asp-controller="Transaction"
                          asp-action="Index"
                          method="get"
                          class="tx-filter-bar">
                        <span class="tx-filter-label">Lọc:</span>

                        <select name="filterWalletId"
                                class="tx-filter-select"
                                onchange="this.form.submit()">
                            <option value="">Tất cả Ví</option>
                            @foreach (var w in Model.Wallets)
                            {
                                <option value="@w.WalletId" selected="@(Model.FilterWalletId == w.WalletId)">
                                    @w.WalletName
                                </option>
                            }
                        </select>

                        <span class="tx-filter-divider">|</span>

                        <select name="filterMonth"
                                class="tx-filter-select"
                                onchange="this.form.submit()">
                            <option value="">Tất cả các tháng</option>
                            @foreach (var m in Model.AvailableMonths)
                            {
                                <option value="@m.Value" selected="@(Model.FilterMonth == m.Value)">
                                    @m.Label
                                </option>
                            }
                        </select>
                    </form>
                </div>

                <!-- Bảng Lịch sử Giao dịch cá nhân (Chỉ xem) -->
                <div class="table-responsive">
                    <table class="table tx-history-table mb-0">
                        <thead>
                            <tr>
                                <th style="width: 13%;">Ngày</th>
                                <th style="width: 18%;">Ví cá nhân</th>
                                <th style="width: 12%;">Loại</th>
                                <th style="width: 16%;">Danh mục</th>
                                <th style="width: 19%;">Mô tả</th>
                                <th style="width: 22%;" class="text-end">Số tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (pagedTransactions.Any())
                            {
                                @foreach (var item in pagedTransactions)
                                {
                                    bool isIncome = string.Equals(item.TransactionType, "Income", StringComparison.OrdinalIgnoreCase);

                                    string rowColorClass = isIncome
                                        ? "tx-row-income"
                                        : (item.IsCategoryDeleted ? "tx-row-deleted-cat" : "tx-row-expense");

                                    string signedAmountText = isIncome
                                        ? $"+{item.Amount:N0} VNĐ"
                                        : $"-{item.Amount:N0} VNĐ";

                                    <tr class="@rowColorClass">
                                        <td class="fw-semibold">@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-semibold">@item.WalletName</td>
                                        <td class="fw-semibold">@(isIncome ? "Thu nhập" : "Chi tiêu")</td>
                                        <td class="fw-semibold">@item.CategoryDisplay</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                                        <td class="text-end fw-bold tx-amount-cell">@signedAmountText</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        Chưa có giao dịch cá nhân nào phù hợp với bộ lọc hiện tại.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Chân bảng & Phân trang (10 lượt giao dịch / 1 trang) -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mt-3">
                   <div></div>

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="Transaction"
                                   asp-action="Index"
                                   asp-route-filterWalletId="@Model.FilterWalletId"
                                   asp-route-filterMonth="@Model.FilterMonth"
                                   asp-route-page="@(currentPage - 1)">
                                    &lt;
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link @(i == currentPage ? "bg-tx-page border-0 text-white" : "text-dark")"
                                       asp-controller="Transaction"
                                       asp-action="Index"
                                       asp-route-filterWalletId="@Model.FilterWalletId"
                                       asp-route-filterMonth="@Model.FilterMonth"
                                       asp-route-page="@i">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="Transaction"
                                   asp-action="Index"
                                   asp-route-filterWalletId="@Model.FilterWalletId"
                                   asp-route-filterMonth="@Model.FilterMonth"
                                   asp-route-page="@(currentPage + 1)">
                                    &gt;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        function switchTransactionMode(mode) {
            const txTypeInput = document.getElementById('txTypeInput');
            const btnExpense = document.getElementById('btnExpenseMode');
            const btnIncome = document.getElementById('btnIncomeMode');
            const categoryWrapper = document.getElementById('categoryFieldWrapper');
            const categorySelect = document.getElementById('categoryIdSelect');

            txTypeInput.value = mode;

            if (mode === 'Income') {
                btnIncome.classList.add('mode-income-active');
                btnExpense.classList.remove('mode-expense-active');
                categoryWrapper.style.display = 'none';
                categorySelect.removeAttribute('required');
            } else {
                btnExpense.classList.add('mode-expense-active');
                btnIncome.classList.remove('mode-income-active');
                categoryWrapper.style.display = 'block';
                categorySelect.setAttribute('required', 'required');
            }
        }

        // Khởi tạo trạng thái ban đầu khi tải trang
        document.addEventListener('DOMContentLoaded', function () {
            const currentMode = document.getElementById('txTypeInput').value || 'Expense';
            switchTransactionMode(currentMode);
        });
    </script>
}

