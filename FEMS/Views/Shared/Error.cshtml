@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="fems-card my-4">
    <h2 class="text-danger fw-bold mb-2">Đã xảy ra lỗi</h2>
    <p class="text-secondary mb-4">Hệ thống gặp sự cố trong quá trình xử lý yêu cầu của bạn. Vui lòng thử lại sau.</p>

    @if (Model.ShowRequestId)
    {
        <div class="p-3 bg-light rounded-3 border mb-3">
            <span class="text-muted small">Mã định danh yêu cầu (Request ID):</span>
            <code class="d-block fw-bold mt-1 text-dark">@Model.RequestId</code>
        </div>
    }

    <a asp-controller="Home" asp-action="Index" class="btn-fems-primary">
        ← Quay lại trang chủ
    </a>
</div>
