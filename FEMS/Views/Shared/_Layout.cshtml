@using System.Security.Claims
@inject FEMS.Services.Interfaces.INotificationService NotificationService

@{
    int unreadCount = 0;

    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int userId))
    {
        var notifications = await NotificationService.GetNotificationsAsync(userId);
        unreadCount = notifications.Count(n => !n.IsRead);
    }
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FEMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FEMS.styles.css" asp-append-version="true" />
</head>
<body>

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">
                FEMS
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex">

                <!-- Navigation Links -->
                <ul class="navbar-nav flex-grow-1">

                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Home"
                           asp-action="Index">
                            Tổng Quan
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Wallet" ? "text-white fw-semibold px-3 rounded-3" : "text-dark")"
                           style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Wallet" ? "background-color: #0D9488;" : "")"
                           asp-controller="Wallet"
                           asp-action="Index">
                            Ví cá nhân
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "text-white fw-semibold px-3 rounded-3" : "text-dark")"
                           style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "background-color: #0d7a5f;" : "")"
                           asp-controller="Category"
                           asp-action="Index">
                            Quản lý Danh mục
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Household" ? "text-white fw-semibold px-3 rounded-3" : "text-dark")"
                           style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Household" ? "background-color: #0D9488;" : "")"
                           asp-controller="Household"
                           asp-action="Index">
                            Hộ gia đình
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FinancialReport" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-white fw-semibold px-3 rounded-3" : "text-dark")"
                           style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "FinancialReport" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "background-color: #0d7a5f;" : "")"
                           asp-controller="FinancialReport"
                           asp-action="Index">
                            Báo cáo tài chính
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FinancialReport" && ViewContext.RouteData.Values["action"]?.ToString() == "Details" ? "text-white fw-semibold px-3 rounded-3" : "text-dark")"
                           style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "FinancialReport" && ViewContext.RouteData.Values["action"]?.ToString() == "Details" ? "background-color: #0d7a5f;" : "")"
                           asp-controller="FinancialReport"
                           asp-action="Details">
                            Báo cáo chi tiết
                        </a>
                    </li>

                   
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notification" ? "text-white fw-semibold px-3 rounded-3" : "text-dark")"
                               style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Notification" ? "background-color: #0d7a5f;" : "")"
                               asp-controller="Notification"
                               asp-action="Index">

                                Thông báo

                                @if (unreadCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill ms-1">
                                        @unreadCount
                                    </span>
                                }

                            </a>
                        </li>


                </ul>

                <!-- User Authentication Section -->
                <div class="d-flex align-items-center gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text">
                            Welcome, @User.Identity.Name
                        </span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link text-dark"
                           asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>
                    }

                </div>
            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

@* <footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - FEMS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer> *@

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
