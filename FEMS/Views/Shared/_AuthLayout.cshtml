<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FEMS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/auth-shared.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/FEMS.styles.css"
          asp-append-version="true" />

    <style>
        .auth-page .auth-input {
            display: block !important;
            width: 100% !important;
            height: 48px !important;
            min-height: 48px !important;
            padding: 0 18px !important;
            font-size: 15px !important;
            color: #35483A !important;
            background-color: #F7FBF7 !important;
            border: 1.5px solid #D5E6D8 !important;
            border-radius: 12px !important;
            outline: none !important;
            box-sizing: border-box !important;
            -webkit-appearance: none !important;
            appearance: none !important;
        }
        .auth-page .auth-input:focus {
            background-color: #FFFFFF !important;
            border-color: #5E9975 !important;
            box-shadow: 0 0 0 3.5px rgba(94, 153, 117, 0.22) !important;
        }
        .auth-page a.intro-pill-btn,
        .auth-page .intro-pill-btn {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-width: 160px !important;
            height: 46px !important;
            padding: 0 36px !important;
            background: transparent !important;
            color: #FFFFFF !important;
            border: 2px solid rgba(255, 255, 255, 0.88) !important;
            border-radius: 999px !important;
            font-size: 15px !important;
            font-weight: 700 !important;
            text-decoration: none !important;
            letter-spacing: 0.4px !important;
            cursor: pointer !important;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12) !important;
            outline: none !important;
        }
        .auth-page a.intro-pill-btn:hover,
        .auth-page .intro-pill-btn:hover {
            background: #FFFFFF !important;
            color: #8B5E3C !important;
            border-color: #FFFFFF !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 24px rgba(61, 48, 40, 0.25) !important;
            text-decoration: none !important;
        }
    </style>
</head>
<body class="auth-page">
    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
