@model FEMS.ViewModels.Category.CategoryViewModel

@{
    ViewData["Title"] = "Quản lý Danh mục Cá nhân";

    int totalCount = Model.Categories.Count;
    int activeCount = Model.Categories.Count(c => c.Status == "Active");
    int inactiveCount = Model.Categories.Count(c => c.Status == "Inactive");

    // Cấu hình phân trang: 5 danh mục / 1 trang
    int pageSize = 5;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    if (totalPages < 1) totalPages = 1;
    if (currentPage < 1) currentPage = 1;
    if (currentPage > totalPages) currentPage = totalPages;

    var pagedCategories = Model.Categories
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
}

<div class="category-page">

    <!-- Tiêu đề trang & Thống kê -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1">Danh mục</h3>
        </div>

        <div id="categoryStats" class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <span class="stat-pill">
                📁 Tổng danh mục: <strong class="ms-1">@totalCount</strong>
            </span>
            <span class="stat-pill">
                <span class="status-dot dot-active me-1"></span> Đang hoạt động: <strong class="text-dark ms-1">@activeCount</strong>
            </span>
            <span class="stat-pill">
                <span class="status-dot dot-inactive me-1"></span> Đã vô hiệu hóa: <strong class="text-dark ms-1">@inactiveCount</strong>
            </span>
        </div>
    </div>

    <div class="row g-4 align-items-stretch">

        <!-- CỘT TRÁI: FORM THÊM / SỬA DANH MỤC -->
        <div class="col-md-4">
            <div class="card card-custom p-4 h-100">

                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <h5 class="fw-bold mb-0">
                        @(Model.CategoryId == 0 ? "Thêm Danh mục" : "Cập nhật Danh mục")
                    </h5>
                    @* <span class="badge bg-fems rounded-pill px-3 py-2">
                        @(Model.CategoryId == 0 ? "Chế độ tạo" : "Chế độ sửa")
                    </span> *@
                </div>

                <!-- Form Lưu Danh Mục -->
                <form asp-controller="Category" asp-action="Save" method="post">
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="HouseholdMemberId" />

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-bold small text-secondary">
                            Tên danh mục <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CategoryName"
                               class="form-control input-custom"
                               placeholder="Ví dụ: Ăn uống, Sinh hoạt, Giải trí..." />
                        <span asp-validation-for="CategoryName" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold small text-secondary">
                            Mô tả
                        </label>
                        <textarea asp-for="Description"
                                  rows="5"
                                  class="form-control input-custom"
                                  placeholder="Ví dụ: Chi phí ăn sáng trưa công sở, xăng xe đi làm..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-fems w-100 py-2">
                        💾 @(Model.CategoryId == 0 ? "Lưu danh mục" : "Cập nhật")
                    </button>

                    @if (Model.CategoryId != 0)
                    {
                        <a asp-controller="Category"
                           asp-action="Index"
                           class="btn btn-light border w-100 mt-2 py-2 small fw-semibold rounded-3">
                            Hủy chỉnh sửa
                        </a>
                    }
                </form>

            </div>
        </div>

        <!-- CỘT PHẢI: DANH SÁCH DANH MỤC -->
        <div id="categoryListArea" class="col-md-8">
            <div class="card card-custom p-4 h-100 d-flex flex-column justify-content-between">

                <div>
                    <!-- Thanh tiêu đề & Bộ lọc tìm kiếm -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="fw-bold mb-0">Danh sách Danh mục</h5>
                            @* <span class="badge bg-fems rounded-pill px-3 py-1">@totalCount danh mục</span> *@
                        </div>

                        <form asp-controller="Category" asp-action="Index" method="get" class="d-flex gap-2">
                            <select name="status"
                                    class="form-select form-select-sm rounded-3"
                                    style="width: 155px;"
                                    onchange="this.form.submit()">
                                <option value="">Tất cả trạng thái</option>
                                <option value="Active" selected="@(ViewBag.Status == "Active")">Đang hoạt động</option>
                                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Đã vô hiệu hóa</option>
                            </select>

                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control form-control-sm rounded-3"
                                   style="width: 190px;"
                                   placeholder="Tìm tên..." />

                            <button type="submit" class="btn btn-sm btn-fems px-3" title="Tìm kiếm">🔍</button>
                        </form>
                    </div>

                    <!-- Bảng dữ liệu (Cố định chiều cao 5 danh mục & cố định độ rộng cột) -->
                    <div class="table-responsive table-fixed-7">
                        <table class="table align-middle mb-0 table-category">
                            <thead>
                                <tr>
                                    <th class="col-stt text-center">STT</th>
                                    <th class="col-name">TÊN DANH MỤC</th>
                                    <th class="col-desc">MÔ TẢ</th>
                                    <th class="col-status text-center">TRẠNG THÁI</th>
                                    <th class="col-action text-center">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (pagedCategories.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-5">
                                            Chưa có danh mục nào phù hợp.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int stt = (currentPage - 1) * pageSize + 1;
                                    foreach (var item in pagedCategories)
                                    {
                                        <tr class="@(item.Status == "Inactive" ? "row-inactive" : "")">
                                            <td class="fw-bold text-fems text-center">@stt</td>
                                            <td class="fw-bold text-wrap-cell">@item.CategoryName</td>
                                            <td class="text-muted small text-wrap-cell">
                                                @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                            </td>
                                            <td class="text-center col-status">
                                                @if (item.Status == "Active")
                                                {
                                                    <span class="status-badge-inline">
                                                        <span class="status-dot dot-active"></span> 
                                                        <span class="status-text">Hoạt động</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge-inline">
                                                        <span class="status-dot dot-inactive"></span> 
                                                        <span class="status-text">Đã vô hiệu hóa</span>
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap">
                                                    @if (item.Status == "Active")
                                                    {
                                                        <a asp-controller="Category"
                                                           asp-action="Index"
                                                           asp-route-editId="@item.CategoryId"
                                                           asp-route-page="@currentPage"
                                                           asp-route-search="@ViewBag.Search"
                                                           asp-route-status="@ViewBag.Status"
                                                           class="btn btn-sm btn-action-edit">
                                                            ✏️ Sửa
                                                        </a>

                                                        <form asp-controller="Category"
                                                              asp-action="ToggleStatus"
                                                              method="post"
                                                              class="m-0 js-toggle-form">
                                                            <input type="hidden" name="id" value="@item.CategoryId" />
                                                            <input type="hidden" name="status" value="Inactive" />
                                                            <input type="hidden" name="page" value="@currentPage" />
                                                            <input type="hidden" name="search" value="@ViewBag.Search" />
                                                            <input type="hidden" name="statusFilter" value="@ViewBag.Status" />
                                                            <button type="submit" class="btn btn-sm btn-action-disable">
                                                                🗑️ Tắt
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <form asp-controller="Category"
                                                              asp-action="ToggleStatus"
                                                              method="post"
                                                              class="m-0 js-toggle-form">
                                                            <input type="hidden" name="id" value="@item.CategoryId" />
                                                            <input type="hidden" name="status" value="Active" />
                                                            <input type="hidden" name="page" value="@currentPage" />
                                                            <input type="hidden" name="search" value="@ViewBag.Search" />
                                                            <input type="hidden" name="statusFilter" value="@ViewBag.Status" />
                                                            <button type="submit" class="btn btn-sm btn-action-restore">
                                                                🔄 Khôi phục
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        stt++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Chân bảng & Phân trang (5 danh mục / trang) -->
                <div class="d-flex justify-content-end align-items-center pt-3 mt-2 border-top">
                    <nav class="ms-auto">
                        <ul class="pagination pagination-sm mb-0 gap-1">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link rounded-2"
                                   asp-controller="Category"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-status="@ViewBag.Status">
                                    &lt;
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link rounded-2 @(i == currentPage ? "bg-fems border-0" : "text-dark")"
                                       asp-controller="Category"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-status="@ViewBag.Status">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link rounded-2"
                                   asp-controller="Category"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-status="@ViewBag.Status">
                                    &gt;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Hàm xử lý ngắt dòng cho từ dài >= 8 ký tự
        function formatLongWords() {
            document.querySelectorAll('.text-wrap-cell').forEach(cell => {
                cell.innerHTML = cell.textContent.replace(/\S{8,}/g, '<span class="long-word" style="word-break:break-all;">$&</span>');
            });
        }

        formatLongWords();

        // Xử lý bấm nút Tắt / Khôi phục không bị refresh lại trang
        document.addEventListener('submit', async function (e) {
            if (e.target.classList.contains('js-toggle-form')) {
                e.preventDefault();
                const form = e.target;

                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form)
                });

                if (response.ok) {
                    const html = await response.text();
                    const doc = new DOMParser().parseFromString(html, 'text/html');

                    // Cập nhật lại bảng danh sách và số lượng thống kê ngay lập tức
                    document.getElementById('categoryListArea').innerHTML = doc.getElementById('categoryListArea').innerHTML;
                    document.getElementById('categoryStats').innerHTML = doc.getElementById('categoryStats').innerHTML;
                    formatLongWords();
                }
            }
        });
    </script>
}
