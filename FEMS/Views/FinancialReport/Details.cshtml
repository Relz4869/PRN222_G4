@model FEMS.ViewModels.FinancialReport.DetailedReportViewModel

@{
    ViewData["Title"] = "Detailed Financial Report";
}

<div class="container mt-4">
    <h2>Detailed Financial Report</h2>
    <p>View your income and expenses by category.</p>

    <div class="mb-4">
        <a asp-action="Details" asp-route-months="3"
           class="btn @(Model.Months == 3 ? "btn-primary" : "btn-outline-primary")">
            3 Months
        </a>

        <a asp-action="Details" asp-route-months="6"
           class="btn @(Model.Months == 6 ? "btn-primary" : "btn-outline-primary")">
            6 Months
        </a>

        <a asp-action="Details" asp-route-months="12"
           class="btn @(Model.Months == 12 ? "btn-primary" : "btn-outline-primary")">
            12 Months
        </a>

        <a asp-action="Index"
           asp-route-months="@Model.Months"
           class="btn btn-secondary">
            Back to Summary
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card p-3">
                <h5>Total Income</h5>
                <h3 class="text-success">
                    @Model.TotalIncome.ToString("N0") VND
                </h3>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card p-3">
                <h5>Total Expenses</h5>
                <h3 class="text-danger">
                    @Model.TotalExpense.ToString("N0") VND
                </h3>
            </div>
        </div>
    </div>

    <div class="card p-4 mb-4">
        <h4>Expense Breakdown by Category</h4>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Transactions</th>
                    <th>Total Expense</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.CategoryName</td>
                        <td>@category.TransactionCount</td>
                        <td>@category.TotalAmount.ToString("N0") VND</td>
                    </tr>
                }

                @if (!Model.Categories.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center">
                            No expense data available.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card p-4 mb-4">
        <h4>Income Transactions</h4>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Date</th>

                    @if (Model.IsManager)
                    {
                        <th>Member</th>
                    }

                    <th>Description</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var income in Model.Incomes)
                {
                    <tr>
                        <td>@income.Date.ToString("dd/MM/yyyy")</td>

                        @if (Model.IsManager)
                        {
                            <td>@income.MemberName</td>
                        }

                        <td>@income.Description</td>
                        <td class="text-success">
                            @income.Amount.ToString("N0") VND
                        </td>
                    </tr>
                }

                @if (!Model.Incomes.Any())
                {
                    <tr>
                        <td colspan="@(Model.IsManager ? 4 : 3)"
                            class="text-center">
                            No income data available.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
