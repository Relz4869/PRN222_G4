
@model FEMS.ViewModels.FinancialReport.FinancialSummaryViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Tổng quan tài chính";

    var memberNames = Model.MemberData.Select(x => x.MemberName).ToList();
    var memberIncomes = Model.MemberData.Select(x => x.Income).ToList();
    var memberExpenses = Model.MemberData.Select(x => x.Expense).ToList();
}

<style>
    .financial-page {
        background-color: #f5f8f7;
        padding: 25px;
        border-radius: 18px;
        margin-bottom: 30px;
    }

    .financial-title {
        color: #173b36;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .financial-subtitle {
        color: #71817b;
    }

    .financial-card {
        background: #ffffff;
        border: 1px solid #e4ebe8;
        border-radius: 15px;
        padding: 22px;
        height: 100%;
    }

    .financial-section {
        background: #ffffff;
        border: 1px solid #e4ebe8;
        border-radius: 15px;
        padding: 24px;
        margin-bottom: 22px;
    }

    .financial-section-title {
        color: #173b36;
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .financial-stat-label {
        color: #71817b;
        font-size: 15px;
        margin-bottom: 10px;
    }

    .financial-stat-value {
        font-size: 27px;
        font-weight: 700;
        white-space: nowrap;
    }

    .financial-chart {
        position: relative;
        height: 330px;
    }

    .financial-pie {
        position: relative;
        height: 310px;
    }

    .btn-fems {
        background-color: #0D9488;
        border: 1px solid #0D9488;
        color: white;
        font-weight: 600;
        border-radius: 9px;
        white-space: nowrap;
    }

    .btn-fems:hover,
    .btn-fems:focus {
        background-color: #0b7f75;
        border-color: #0b7f75;
        color: white;
    }

    .btn-fems-outline {
        background-color: white;
        border: 1px solid #0D9488;
        color: #0D9488;
        border-radius: 9px;
        white-space: nowrap;
    }

    .btn-fems-outline:hover,
    .btn-fems-outline:focus {
        background-color: #0D9488;
        color: white;
    }

    .financial-filter {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .financial-table th {
        background-color: #f0f6f3;
        color: #415b51;
        padding: 14px;
        white-space: nowrap;
    }

    .financial-table td {
        padding: 13px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .financial-table tbody tr:hover {
        background-color: #f5faf8;
    }

    @@media (max-width: 767px) {
        .financial-page {
            padding: 12px;
        }

        .financial-stat-value {
            font-size: 22px;
            white-space: normal;
        }

        .financial-chart {
            height: 270px;
        }
    }
</style>

<div class="financial-page">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h2 class="financial-title">Tổng quan tài chính</h2>
            <p class="financial-subtitle mb-0">
                Theo dõi thu nhập và chi tiêu theo thời gian.
            </p>
        </div>

        <a asp-controller="FinancialReport"
           asp-action="Details"
           asp-route-months="@Model.Months"
           asp-route-selectedMonth="@Model.SelectedMonth"
           class="btn btn-fems px-3 py-2">
            Xem báo cáo chi tiết
        </a>
    </div>

    <div class="financial-section">

        <form asp-controller="FinancialReport"
              asp-action="Index"
              method="get"
              class="financial-filter mb-3">

            <label for="selectedMonth" class="fw-semibold text-nowrap">
                Chọn tháng:
            </label>

            <input type="month"
                   id="selectedMonth"
                   name="selectedMonth"
                   value="@Model.SelectedMonth"
                   class="form-control"
                   style="width: 190px;" />

            <input type="hidden"
                   name="months"
                   value="@Model.Months" />

            <button type="submit"
                    class="btn btn-fems px-3">
                Xem báo cáo
            </button>
        </form>

        <div class="financial-filter">
            <a asp-action="Index"
               asp-route-months="1"
               asp-route-selectedMonth="@Model.SelectedMonth"
               class="btn @(Model.Months == 1 ? "btn-fems" : "btn-fems-outline")">
                1 tháng
            </a>

            <a asp-action="Index"
               asp-route-months="3"
               asp-route-selectedMonth="@Model.SelectedMonth"
               class="btn @(Model.Months == 3 ? "btn-fems" : "btn-fems-outline")">
                3 tháng
            </a>

            <a asp-action="Index"
               asp-route-months="6"
               asp-route-selectedMonth="@Model.SelectedMonth"
               class="btn @(Model.Months == 6 ? "btn-fems" : "btn-fems-outline")">
                6 tháng
            </a>

            <a asp-action="Index"
               asp-route-months="12"
               asp-route-selectedMonth="@Model.SelectedMonth"
               class="btn @(Model.Months == 12 ? "btn-fems" : "btn-fems-outline")">
                12 tháng
            </a>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-lg-4">
            <div class="financial-card">
                <div class="financial-stat-label">
                    Tổng thu nhập
                </div>
                <div class="financial-stat-value" style="color:#0D9488;">
                    @Model.TotalIncome.ToString("N0") VNĐ
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="financial-card">
                <div class="financial-stat-label">
                    Tổng chi tiêu
                </div>
                <div class="financial-stat-value" style="color:#dc3545;">
                    @Model.TotalExpense.ToString("N0") VNĐ
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="financial-card">
                <div class="financial-stat-label">
                    Chênh lệch thu chi
                </div>
                <div class="financial-stat-value"
                     style="color:@(Model.NetIncome >= 0 ? "#173b36" : "#dc3545");">
                    @Model.NetIncome.ToString("N0") VNĐ
                </div>
            </div>
        </div>

    </div>

    <div class="financial-section">
        <h4 class="financial-section-title">
            Biểu đồ thu nhập và chi tiêu
        </h4>

        @if (Model.TotalIncome == 0 && Model.TotalExpense == 0)
        {
            <div class="text-center text-muted py-5">
                Chưa có giao dịch trong khoảng thời gian này.
            </div>
        }
        else
        {
            <div class="financial-chart">
                <canvas id="monthlyChart"></canvas>
            </div>
        }
    </div>

    <div class="financial-section">
        <h4 class="financial-section-title">
            Thống kê theo tháng
        </h4>

        <div class="table-responsive">
            <table class="table table-bordered financial-table">
                <thead>
                    <tr>
                        <th>Tháng</th>
                        <th>Thu nhập</th>
                        <th>Chi tiêu</th>
                        <th>Chênh lệch</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.MonthlyData)
                    {
                        decimal balance = item.Income - item.Expense;

                        <tr>
                            <td class="fw-semibold">@item.Month</td>

                            <td style="color:#0D9488;">
                                @item.Income.ToString("N0") VNĐ
                            </td>

                            <td style="color:#dc3545;">
                                @item.Expense.ToString("N0") VNĐ
                            </td>

                            <td class="fw-semibold"
                                style="color:@(balance >= 0 ? "#173b36" : "#dc3545");">
                                @balance.ToString("N0") VNĐ
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.MemberData.Any())
    {
        <div class="financial-section">
            <h4 class="financial-section-title">
                Tỷ trọng tài chính của các thành viên
            </h4>

            <div class="row g-4">

                <div class="col-lg-6">
                    <h5 class="text-center mb-3">
                        Tỷ trọng thu nhập
                    </h5>

                    @if (memberIncomes.Sum() > 0)
                    {
                        <div class="financial-pie">
                            <canvas id="incomePie"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">
                            Chưa có dữ liệu thu nhập.
                        </p>
                    }
                </div>

                <div class="col-lg-6">
                    <h5 class="text-center mb-3">
                        Tỷ trọng chi tiêu
                    </h5>

                    @if (memberExpenses.Sum() > 0)
                    {
                        <div class="financial-pie">
                            <canvas id="expensePie"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">
                            Chưa có dữ liệu chi tiêu.
                        </p>
                    }
                </div>

            </div>
        </div>
    }

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>

<script>
    const monthlyData = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyData));

    const memberNames = @Html.Raw(JsonSerializer.Serialize(memberNames));
    const memberIncomes = @Html.Raw(JsonSerializer.Serialize(memberIncomes));
    const memberExpenses = @Html.Raw(JsonSerializer.Serialize(memberExpenses));

    const moneyFormat = value =>
        Number(value).toLocaleString("vi-VN") + " VNĐ";

    const monthlyCanvas = document.getElementById("monthlyChart");

    if (monthlyCanvas && typeof Chart !== "undefined") {
        new Chart(monthlyCanvas, {
            type: "bar",
            data: {
                labels: monthlyData.map(x => x.Month),
                datasets: [
                    {
                        label: "Thu nhập",
                        data: monthlyData.map(x => x.Income),
                        backgroundColor: "#0D9488",
                        borderRadius: 7,
                        maxBarThickness: 50
                    },
                    {
                        label: "Chi tiêu",
                        data: monthlyData.map(x => x.Expense),
                        backgroundColor: "#dc3545",
                        borderRadius: 7,
                        maxBarThickness: 50
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: item =>
                                item.dataset.label + ": " + moneyFormat(item.raw)
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value =>
                                Number(value).toLocaleString("vi-VN")
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    }

    const colors = [
        "#0D9488",
        "#3b82f6",
        "#f59e0b",
        "#8b5cf6",
        "#ec4899",
        "#64748b",
        "#14b8a6"
    ];

    function createPieChart(elementId, values) {
        const canvas = document.getElementById(elementId);

        if (!canvas || typeof Chart === "undefined") {
            return;
        }

        new Chart(canvas, {
            type: "doughnut",
            data: {
                labels: memberNames,
                datasets: [{
                    data: values,
                    backgroundColor: memberNames.map(
                        (_, index) => colors[index % colors.length]
                    ),
                    borderColor: "#ffffff",
                    borderWidth: 3,
                    hoverOffset: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: "60%",
                plugins: {
                    legend: {
                        position: "bottom",
                        labels: {
                            padding: 15,
                            usePointStyle: true
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: item => {
                                const total = item.dataset.data
                                    .reduce((sum, value) => sum + Number(value), 0);

                                const percentage = total > 0
                                    ? (Number(item.raw) / total * 100).toFixed(1)
                                    : "0";

                                return item.label + ": " +
                                    moneyFormat(item.raw) +
                                    " (" + percentage + "%)";
                            }
                        }
                    }
                }
            }
        });
    }

    createPieChart("incomePie", memberIncomes);
    createPieChart("expensePie", memberExpenses);
</script>
