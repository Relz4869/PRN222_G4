@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Thiết lập Hộ gia đình";
    int pendingInviteCount = ViewBag.PendingInviteCount ?? 0;
}

<div class="setup-container">

    <!-- Left panel - Branding -->
    <section class="setup-brand">
        <div class="setup-brand-content">
            <h1>
                Bắt đầu hành trình
                <br />
                quản lý chi tiêu gia đình
            </h1>

            <p>
                Theo quy định của FEMS, mỗi tài khoản cần thuộc về một hộ gia đình
                để sử dụng các tính năng quản lý ví cá nhân, danh mục và ngân sách.
            </p>

            <div class="setup-brand-logo">
                Hộ gia đình FEMS
            </div>
        </div>
    </section>

    <!-- Right panel - Choice cards -->
    <section class="setup-choice-section">
        <div class="setup-choice-box">

            <div class="setup-header">
                <span class="setup-welcome">Xin chào, <strong>@User.Identity?.Name</strong>!</span>
                <h2>Chọn cách bắt đầu</h2>
                <p>Bạn muốn tạo một hộ gia đình mới hay tham gia vào hộ gia đình sẵn có?</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="setup-alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div class="choice-grid">

                <!-- Option 1: Tạo hộ gia đình -->
                <div class="choice-card choice-card-primary"
                     role="button"
                     tabindex="0"
                     onclick="window.location.href='@Url.Action("Create", "Household")'">

                    <div class="choice-icon choice-icon-teal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.707 1.5ZM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5 5 5Z"/>
                            <path d="M8 5.5a.5.5 0 0 1 .5.5v1.5H10a.5.5 0 0 1 0 1H8.5V10a.5.5 0 0 1-1 0V8.5H6a.5.5 0 0 1 0-1h1.5V6a.5.5 0 0 1 .5-.5Z"/>
                        </svg>
                    </div>

                    <div class="choice-body">
                        <div class="choice-title-row">
                            <h3>Tạo hộ gia đình</h3>
                            <span class="role-badge badge-manager">Quản lý hộ</span>
                        </div>
                        <p>
                            Khởi tạo hộ gia đình mới của riêng bạn, mời các thành viên tham gia
                            và thiết lập kế hoạch ngân sách chung.
                        </p>
                    </div>

                    <div class="choice-arrow">&rarr;</div>
                </div>

                <!-- Option 2: Tham gia hộ gia đình -->
                <div class="choice-card choice-card-secondary"
                     role="button"
                     tabindex="0"
                     onclick="window.location.href='@Url.Action("Join", "Household")'">

                    <div class="choice-icon choice-icon-amber">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                        </svg>
                    </div>

                    <div class="choice-body">
                        <div class="choice-title-row">
                            <h3>Tham gia hộ gia đình</h3>
                            @if (pendingInviteCount > 0)
                            {
                                <span class="role-badge badge-invite">@pendingInviteCount lời mời mới</span>
                            }
                            else
                            {
                                <span class="role-badge badge-member">Thành viên</span>
                            }
                        </div>
                        <p>
                            Chuyển sang trang chờ và nhập mã mời từ Quản lý hộ gia đình
                            để kết nối vào hộ của bạn.
                        </p>
                    </div>

                    <div class="choice-arrow">&rarr;</div>
                </div>

            </div>

            <div class="setup-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn-logout-link">
                        Đăng xuất khỏi tài khoản này
                    </button>
                </form>
            </div>

        </div>
    </section>

</div>

